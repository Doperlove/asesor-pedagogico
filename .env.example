# ===== Asesor Pedagógico Inteligente — variables de entorno =====
APP_ENV=production
# Railway inyecta DATABASE_URL al agregar PostgreSQL. Local: sqlite:///./data/asesor.db
DATABASE_URL=sqlite:///./data/asesor.db
# Genere una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
COOKIE_SECURE=true
TOKEN_MINUTES=480
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25

# ---- Conector de modelo (el docente puede cambiarlo en la UI) ----
# mock | ollama | gemini | openai | anthropic   (gratis: ollama o gemini)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_S=180
LLM_MAX_INPUT_CHARS=90000
# OpenAI o cualquier API compatible (DeepSeek, Groq, OpenRouter, Gemini...)
OPENAI_API_KEY=
# json_schema (OpenAI) | json_object (DeepSeek y otros que no soportan json_schema)
OPENAI_JSON_MODE=json_schema
ANTHROPIC_API_KEY=
# Google Gemini (plan gratuito, sin tarjeta): crear la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_JSON_MODE=json_object

# ---- Sandbox ----
# auto | docker | unshare | rlimit
SANDBOX_MODE=auto
SANDBOX_IMAGE=asesor-sandbox:latest
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=512
ALLOW_RLIMIT_FALLBACK=true

# Opcional: para descargar repositorios privados o evitar límites de la API de GitHub
GITHUB_TOKEN=

# ---- Datos de demostración ----
SEED_DEMO=true
DEMO_PASSWORD=cambie-esta-clave-demo
